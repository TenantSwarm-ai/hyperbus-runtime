FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
# Worker image: runtime only — no postgres extra
RUN pip install --no-cache-dir .

# Placeholder app — replace with your LangGraph graph
RUN mkdir -p /app/demo && printf '%s\n' 'print("hyperbus worker stub")' > /app/demo/graph.py

CMD ["hyperbus-worker", "python", "/app/demo/graph.py"]
