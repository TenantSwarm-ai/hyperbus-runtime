FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir '.[postgres]'

COPY examples/docker-compose/acme-grants.yaml /etc/hyperbus/grants.yaml

EXPOSE 8080
CMD ["hyperbus-engine", "--tenant", "acme", "--grants", "/etc/hyperbus/grants.yaml", "--listen", "0.0.0.0:8080"]
